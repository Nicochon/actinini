# Projet Supabase — bouton « Connect » du dashboard, onglet Framework > Next.js
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Le code accepte les deux noms : Supabase distribue aujourd'hui
# PUBLISHABLE_KEY, les projets plus anciens ont ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Notifications push (VAPID) ---
# Générer la paire avec `npx web-push generate-vapid-keys`, puis reporter la
# même paire ici et dans les variables d'environnement Vercel. La clé publique
# part dans le navigateur, la privée ne sort jamais du serveur.
# Sans ces deux variables l'app fonctionne : seules les notifications sont muettes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
